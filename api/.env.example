PORT=3001
CORS_ORIGINS=http://localhost:5173
# Stub mode uses temporary memory only when DATABASE_URL is empty.
# With DATABASE_URL set, listing/order repositories persist even while other modules remain stubs.
# Run db:migrate to add the three predefined demo accounts and bearer-session tables.
API_STUBS=true
DEMO_MODE=true
DATABASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com
# Optional HTTPS Nominatim-compatible place provider; default is the public OSM service for low-traffic demos.
GEOCODING_BASE_URL=
ROUTING_BASE_URL=
ROUTING_API_KEY=
MAX_PLAN_MS=45000

# Configure an approved OSRM-compatible provider; no implicit default.
ROUTING_BASE_URL=
ROUTING_PROFILE=driving
