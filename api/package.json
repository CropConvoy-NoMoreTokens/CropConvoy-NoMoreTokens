{
  "name": "cropconvoy-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts src/core/*.test.ts src/modules/*/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-persistence.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "llm:check": "tsx scripts/check-llm.ts",
    "geocode:check": "tsx scripts/check-geocode.ts",
    "market:check": "tsx scripts/check-market.ts",
    "api:restart-check": "tsx scripts/check-restart.ts",
    "contracts:export": "tsx scripts/export-contracts.ts",
    "api:integration-check": "tsx scripts/check-integrated-providers.ts"
  },
  "dependencies": {
    "@turf/turf": "7.4.0",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
